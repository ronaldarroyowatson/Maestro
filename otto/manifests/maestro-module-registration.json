  ],
  "observability": {
    "logsPath": "{otto.dataDir}/logs/maestro",
    "tracesPath": "{otto.dataDir}/traces/maestro",
    "telemetryPath": "{otto.dataDir}/telemetry/maestro",
    "diagnosticsPath": "{otto.dataDir}/diagnostics/maestro"
  }
