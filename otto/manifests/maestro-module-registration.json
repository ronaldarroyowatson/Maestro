{
  "schemaVersion": "1.0.0",
  "moduleId": "maestro",
  "displayName": "Maestro",
  "category": "runtime",
  "entryRoute": "/maestro/install-status",
  "uiContract": "otto/manifests/maestro-ui-contract.json",
  "panels": [
    "install-status",
    "runtime-status",
    "node-graph",
    "logs",
    "telemetry"
