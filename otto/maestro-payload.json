{
  "$schema": "./schemas/maestro-payload.schema.json",
  "schemaVersion": "1.0.0",
  "payloadId": "maestro-runtime-stable",
  "payloadVersion": "0.1.9",
  "product": {
    "id": "maestro",
    "name": "Maestro Runtime",
    "channel": "stable"
  },
  "runtimeRequirements": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0",
    "python": ">=3.11.0"
  },
  "artifacts": [
    {
      "id": "otto-protocol",
      "type": "git",
      "uri": "https://github.com/otto-systems/otto-protocol.git",
      "ref": "main",
      "installPath": "{otto.dataDir}/otto-protocol"
    },
    {
      "id": "otto-server",
      "type": "git",
      "uri": "https://github.com/otto-systems/otto-server.git",
      "ref": "main",
      "installPath": "{otto.dataDir}/otto-server"
    },
    {
      "id": "otto-kernel",
      "type": "git",
      "uri": "https://github.com/otto-systems/otto-kernel.git",
      "ref": "main",
      "installPath": "{otto.dataDir}/otto-kernel"
    },
    {
      "id": "otto-ui",
      "type": "git",
      "uri": "https://github.com/otto-systems/otto-ui.git",
      "ref": "main",
      "installPath": "{otto.dataDir}/otto-ui"
    },
    {
      "id": "otto-extensions-core",
      "type": "git",
      "uri": "https://github.com/otto-systems/otto-extensions.git",
      "ref": "main",
      "installPath": "{otto.dataDir}/otto-extensions"
    },
    {
      "id": "otto-extension-index",
      "type": "git",
      "uri": "https://github.com/otto-extensions/otto-extension-index.git",
      "ref": "main",
      "installPath": "{otto.dataDir}/otto-extension-index"
    },
    {
      "id": "otto-command-service",
      "type": "git",
      "uri": "https://github.com/otto-systems/otto-command-service.git",
      "ref": "main",
      "version": "0.2.1",
      "installPath": "{otto.dataDir}/otto-command-service"
    },
    {
      "id": "maestro-source",
      "type": "git",
      "uri": "https://github.com/ronaldarroyowatson/Maestro.git",
      "ref": "main",
      "installPath": "{otto.dataDir}/maestro"
    },
    {
      "id": "maestro-dist",
      "type": "build",
      "buildCommand": "pnpm install --frozen-lockfile && pnpm build",
      "workingDirectory": "{otto.dataDir}/maestro",
      "outputs": [
        "dist"
      ]
    }
  ],
  "packages": {
    "npm": [
      "ajv@^8.17.1",
      "better-sqlite3@^11.8.1"
    ],
    "pip": []
  },
  "configuration": {
    "defaults": [
      {
        "source": "ui/settings/maestro-ui-settings.json",
        "target": "{otto.configDir}/maestro/ui-settings.json"
      },
      {
        "source": "ui/nodes/maestro-node-graphs.json",
        "target": "{otto.configDir}/maestro/node-graphs.json"
      },
      {
        "source": "otto/manifests/maestro-ui-contract.json",
        "target": "{otto.configDir}/maestro/ui-contract.json"
      }
    ],
    "paths": {
      "logs": "{otto.dataDir}/logs/maestro",
      "traces": "{otto.dataDir}/traces/maestro",
      "telemetry": "{otto.dataDir}/telemetry/maestro"
    }
  },
  "extensions": {
    "required": [
      {
        "id": "logging.module",
        "source": "@otto/extensions"
      },
      {
        "id": "tracing.module",
        "source": "@otto/extensions"
      },
      {
        "id": "metrics.module",
        "source": "@otto/extensions",
        "alias": "telemetry.module"
      }
    ],
    "optional": []
  },
  "ui": {
    "contract": "otto/manifests/maestro-ui-contract.json",
    "nodeGraphs": "ui/nodes/maestro-node-graphs.json",
    "settings": "ui/settings/maestro-ui-settings.json",
    "navigation": "ui/navigation/maestro-panels.json"
  },
  "commands": {
    "manifest": "otto/maestro-commands.json",
    "sourceOfTruth": {
      "repo": "../Otto/otto-command-service",
      "schemaPath": "src/schemas"
    }
  },
  "lifecycleHooks": {
    "preInstall": "installer/hooks/pre-install.sh",
    "postInstall": "installer/hooks/post-install.sh",
    "preUpdate": "installer/hooks/pre-update.sh",
    "postUpdate": "installer/hooks/post-update.sh"
  },
  "telemetryEvents": [
    "maestro.download.started",
    "maestro.download.completed",
    "maestro.install.started",
    "maestro.install.completed",
    "maestro.install.failed",
    "maestro.install.retry"
  ]
}
