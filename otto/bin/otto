#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_LAUNCHER="${SCRIPT_DIR}/../runtime/otto-bootstrap.mjs"

resolve_node() {
  local candidate=""
  for candidate in \
    "${SCRIPT_DIR}/node" \
    "$(command -v node 2>/dev/null || true)" \
    "/opt/homebrew/bin/node" \
    "/usr/local/bin/node"; do
    if [[ -n "${candidate}" && -x "${candidate}" ]]; then
      echo "${candidate}"
      return 0
    fi
  done

  echo "Embedded Node.js binary not found. Expected ${SCRIPT_DIR}/node or a system node installation." >&2
  return 1
}

if [[ ! -f "${RUNTIME_LAUNCHER}" ]]; then
  echo "Embedded Otto runtime launcher not found: ${RUNTIME_LAUNCHER}" >&2
  exit 1
fi

NODE_BIN="$(resolve_node)"

exec "${NODE_BIN}" "${RUNTIME_LAUNCHER}" "$@"