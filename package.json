{
    "name": "maestro",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "check:otto-upstreams": "node --import tsx ./scripts/sync-otto-upstreams.ts",
        "sync:otto-upstreams": "node --import tsx ./scripts/sync-otto-upstreams.ts --apply",
        "verify:otto-upstreams-live": "node --import tsx ./scripts/verify-otto-upstreams-live.ts",
        "validate:command-service": "node --import tsx ./src/shared/utils/commandServiceContract.ts",
        "validate:otto-upstream-contract": "node --import tsx ./src/shared/utils/ottoUpstreamIntegrationContract.ts",
        "validate:otto-ui-contract": "node --import tsx ./scripts/otto-ui-tracer-bullet.ts",
        "verify:diagnostics-artifacts": "node --import tsx ./scripts/verify-diagnostics-artifacts.ts",
        "verify:observability-bridge-diagnostics": "node --import tsx ./scripts/verify-observability-bridge-diagnostics.ts",
        "check:ai-discovery-env": "node --import tsx ./scripts/verify-local-ai-discovery-env.ts",
        "validate:ai-discovery-local": "node --import tsx ./scripts/run-local-ai-discovery-validation.ts",
        "validate:ai-discovery-continuous": "node --import tsx ./scripts/validate-continuous-ai-discovery.ts"
    },
    "dependencies": {
        "@otto/command-service": "file:../otto-command-service",
        "ajv": "^8.17.1",
        "better-sqlite3": "^11.8.1",
        "tsx": "^4.19.2"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.12",
        "@types/node": "^22.16.5",
        "typescript": "^5.8.3",
        "vitest": "^2.1.8"
    },
    "allowScripts": {}
}
