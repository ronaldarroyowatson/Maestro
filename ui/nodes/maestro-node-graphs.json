          "id": "in",
          "direction": "in",
          "dataType": "any",
          "required": true
        },
        {
          "id": "out",
          "direction": "out",
          "dataType": "any",
          "required": false
        }
      ]
    },
    {
      "id": "pipeline.node",
      "label": "Pipeline",
