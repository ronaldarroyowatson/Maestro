{
  "version": "1.0.0",
  "runtime": "maestro",
  "defaults": {
    "startView": "runtime-monitor",
    "showLogsPanel": true,
    "showTelemetryPanel": true,
    "showTracingPanel": true,
    "logVerbosity": "info",
    "traceSamplingRate": 1,
    "telemetryEnabled": true
  },
  "availableViews": [
    "install-status",
    "workflow-builder",
    "runtime-monitor",
    "registry-browser",
    "node-graph",
    "execution-timeline",
    "diagnostics",
    "logs",
    "telemetry"
  ],
  "preferences": {
    "persistAcrossSessions": true,
    "allowPerWorkspaceOverride": true
  }
}
